# ============================================================
# Idéfix — Environment variables
# Copy to .env and fill in your values. Never commit .env.
#
# Reproducing the results on the public corpus needs NONE of this file:
#   uv run --extra embed python scripts/bootstrap.py      (or: make setup)
# The bootstrap never reads .env; it injects the local DATABASE_URL below into
# every step itself. Copy this file only to run individual scripts by hand.
# ============================================================

# --- PostgreSQL (DEFAULT: local Docker database, docker-compose.yml) ---
# Started and restored by scripts/bootstrap.py (`make db-up`). Local-only
# credentials, port bound to 127.0.0.1. Keep +asyncpg (Alembic uses the async
# driver). If you changed IDEFIX_DB_PORT, change the port here too.
DATABASE_URL=postgresql+asyncpg://idefix:idefix@localhost:5433/idefix

# Alternative — hosted PostgreSQL (Supabase Session Pooler, port 5432):
# copy the connection string from Supabase Dashboard > Connect > Session pooler,
# use a dedicated owner role, keep +asyncpg, require SSL. Never commit the real
# URL or password.
# DATABASE_URL=postgresql+asyncpg://idefix_owner.PROJECT_REF:STRONG_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?ssl=require

# --- Telegram MTProto account/session (OPTIONAL: collection only) ---
# Only needed to COLLECT new data (make backfill / make crawl / crawlers).
# Not needed to reproduce anything on the published corpus.
# The collector ALWAYS uses YOUR account/session. These are SECRETS — a runtime
# execution dependency, NOT business data: never hardcode them, never commit .env,
# and they are NEVER written to the exported data/ bundle (export_static scrubs
# them by key AND by value). Resolved by src/ingestor/session.py, which prefers
# the canonical TELEGRAM_* names and falls back to the legacy TG_* aliases.
# Get API id/hash at https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session string — generated once via: make session
TELEGRAM_SESSION_STRING=
# Phone number of the Telegram account (first-time auth / session rotation).
TELEGRAM_PHONE_NUMBER=
#
# Legacy aliases (still honored; TELEGRAM_* above take precedence if both set):
# TG_API_ID=
# TG_API_HASH=
# TG_SESSION_STRING=
# TG_PHONE=

# --- LLM (OPTIONAL: parallel-track Mistral classification, "llm" extra) ---
# Used ONLY by the paid offline classification scripts (classify_channels_llm.py,
# label_communities_llm.py), which the reproducible pipeline does not run.
# The key is a SECRET: scrubbed from every export by key AND by value
# (src/ingestor/session.secret_values + export_static), never logged, never
# stored in the cache or DB. Install client: uv sync --extra llm.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_API_BASE=https://api.mistral.ai/v1

# --- Logging ---
LOG_LEVEL=INFO
