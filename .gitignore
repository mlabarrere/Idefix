# Secrets — NEVER commit
.env
.env.*
!.env.example
*.session
*.session-journal

# Data — gitignored sauf .gitkeep
data/annotations/*
data/catalogue/*
data/claims/*
!data/claims/claims_fr.jsonl
data/dossiers/*
data/exports/*
data/graphs/*
data/models/*
data/raw/*
data/russosphere/
!data/**/.gitkeep

# LLM offline cache (Mistral parallel track) — régénérable, peut contenir du texte
# de messages dans les requêtes ; jamais committé. Re-runs gratuits depuis ce cache.
data/llm_cache/

# Cache d'embeddings (sentence-transformers) — régénérable, peut contenir du texte
# de messages ; jamais committé.
data/embed_cache/

# DB locale
*.db
*.db-journal

# Backups DB (pg_dump) — redondance via OneDrive, hors git (volumineux)
backups/
*.dump

# Public dataset release: the manifest, datasheet and README under dataset/ are
# tracked; the artefacts fetched or built locally (scripts/bootstrap.py fetch,
# scripts/release_dataset.py) land in dataset/downloads/ and never enter git.
dataset/downloads/

# Bundle statique généré (scripts/export_static.py) — contient le dataset complet
data/*.json
data/*.js
data/episodes/

# Mode Vercel-only : le bundle servi par la webapp statique est committé et
# déployé avec le repo (auto-deploy git-push). Régénérable via analyze_*.py.
# Build & deps Vite
webapp/dist/
webapp/node_modules/
webapp/.vercel/

# Rapports de validation/falsification (régénérables ; contiennent du texte de messages)
data/eval/

# Session web Streamlit
disinfo_auth.session
test_*.session

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.uv/
*.egg-info/
dist/
build/

# Keep annotations (small, valuable)
!data/annotations/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# NB: uv.lock is intentionally version-controlled (NOT ignored) for reproducible installs.

# BMAD framework local
_bmad/
_bmad-output/
# Claude Code local state — not tracked in OSS repo
.claude
.claude/
.agents/

# Docs stale
docs/onboarding-report.html
docs/operational-plan.html

# CLI Vercel installée localement à la racine (junk)
/node_modules/
/package.json
/package-lock.json

# Static analyst bundles are NOT published in this repository.
# They are produced locally by scripts/export_static.py and are, by construction,
# specific to a corpus and a scoring run. Publishing them would ship numbers that
# no third party can regenerate. Keep them on disk, out of git.
webapp/public/data/
.vercel
.env*
# The template holds no secret and documents the setup: keep it publishable
# (the `.env*` line above would otherwise re-ignore it).
!.env.example
